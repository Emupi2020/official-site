{
  "name": "emupi-requests",
  "workers_dev": true,
  "preview_urls": false,
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-21",
  "triggers": {"crons": ["17 19 * * *"]},
  "assets": {"directory": "./request", "binding": "ASSETS", "run_worker_first": ["/api/*", "/auth/*", "/admin*", "/config.js", "/demo", "/demo/", "/demo.html"]},
  "d1_databases": [{"binding": "DB", "database_name": "emupi-requests", "database_id": "808c6d08-9791-4783-8855-5c017cb40f54", "migrations_dir": "migrations"}],
  "vars": {"PUBLIC_ORIGIN": "https://emupi2020.github.io", "OFFICIAL_URL": "https://emupi2020.github.io/official-site/"}
}
